{
  "openapi": "3.0.3",
  "info": {
    "title": "bet-agg HTTP API",
    "description": "Laravel bet aggregation service: public `/api/*` JSON APIs and health check. User profile is **not** served here—call the Foundation (or API gateway) user API; bet-agg only **outbounds** to that service to resolve `X-User-Access-Token`. JSON responses use the `ApiResponse` envelope (`data`, `errorCode`, `message`, `_req_id`). Local catalog betting state is in `biz_game` (status + settlement payload), optional many-to-many links to `biz_game_group` (`code` is a stable grouping key), `biz_market`, and `biz_selection`; game copy/media/kickoff are merged from CMS (`GET /api/cms/game?ids=…`) using `biz_game.raw_id` as the CMS id—not duplicated in `biz_game`. Bet order lines reference a selection via `kid`.\n\n**Internal infrastructure** (XXL-Job HTTP callbacks) lives under `/internal/*` and is intentionally NOT documented here.\n\n**Examples:** Reusable request/response samples are under `components.examples` and referenced from operations. **Contract tests:** `Tests\\Feature\\OpenApiRoutesContractTest` asserts every path/method in this file is registered in the app.",
    "version": "1.8.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Same-origin base path (set your deployment host in the client)"
    }
  ],
  "tags": [
    {
      "name": "Bet",
      "description": "Betting catalog, orders, points, atomic placement"
    },
    {
      "name": "Meta",
      "description": "Self-describing endpoints (OpenAPI, dictionaries)"
    },
    {
      "name": "Health",
      "description": "Liveness"
    }
  ],
  "components": {
    "securitySchemes": {
      "UserAccessToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-User-Access-Token",
        "description": "Raw JWT from the Foundation (or BFF) auth service; not issued by bet-agg. Send on bet APIs that require a logged-in user."
      }
    },
    "schemas": {
      "ApiEnvelope": {
        "type": "object",
        "required": [
          "data",
          "errorCode",
          "message",
          "_req_id"
        ],
        "properties": {
          "data": {},
          "errorCode": {
            "type": "integer",
            "description": "0 = success"
          },
          "message": {
            "type": "string"
          },
          "_req_id": {
            "type": "string"
          }
        }
      },
      "BetOrderLine": {
        "type": "object",
        "properties": {
          "kid": {
            "type": "integer",
            "description": "biz_selection.id"
          },
          "stake_points": {
            "type": "integer"
          },
          "decimal_odds_millis": {
            "type": "integer"
          },
          "potential_return_points": {
            "type": "integer"
          },
          "odds_snapshot": {},
          "result": {
            "type": "integer",
            "description": "BetLineResult: 0 pending, 1 win, 2 lose, 3 void"
          }
        }
      },
      "BetOrderFull": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "uid": {
            "type": "integer"
          },
          "status": {
            "type": "integer",
            "description": "BetOrderStatus enum int"
          },
          "total_price": {
            "type": "integer"
          },
          "points_held": {
            "type": "integer",
            "description": "Stake held from user's points wallet after checkout (normally equals total_price)"
          },
          "ct": {
            "type": "integer"
          },
          "ut": {
            "type": "integer"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BetOrderLine"
            }
          }
        }
      },
      "BetOrderSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "uid": {
            "type": "integer"
          },
          "status": {
            "type": "integer"
          },
          "total_price": {
            "type": "integer"
          },
          "ct": {
            "type": "integer"
          },
          "ut": {
            "type": "integer"
          }
        }
      },
      "ListPagination": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer"
          },
          "per_page": {
            "type": "integer"
          },
          "current_page": {
            "type": "integer"
          },
          "last_page": {
            "type": "integer"
          }
        }
      },
      "GameGroup": {
        "type": "object",
        "description": "Local `biz_game_group` row referenced from a game detail payload.",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Local `biz_game_group.id`"
          },
          "code": {
            "type": "string",
            "description": "Unique business code (e.g. fifa-2026-group)"
          }
        },
        "required": [
          "id",
          "code"
        ]
      },
      "Game": {
        "type": "object",
        "description": "Local `biz_game` betting row with CMS overlay. `id` is the local surrogate key; `cms_id` is the CMS primary key (`raw_id`). `GET /api/bet/games` merges `title`, `description`, and `banner` from CMS; `GET /api/bet/games/{game_id}` also adds `main_media`, `start_at` (epoch millis from CMS `starts_at`), and `groups` (many-to-many `biz_game_group`). CMS failures surface as HTTP errors from bet-agg.",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Local `biz_game.id`"
          },
          "cms_id": {
            "type": "integer",
            "description": "CMS / external game id (`biz_game.raw_id`)"
          },
          "status": {
            "type": "integer",
            "description": "1 = open, 2 = closed, 3 = settled"
          },
          "winning_selection_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Set when status is settled; empty array otherwise"
          },
          "ut": {
            "type": "integer",
            "description": "Last update time (milliseconds)"
          },
          "title": {
            "type": "string",
            "nullable": true,
            "description": "From CMS; null if unavailable"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "From CMS; null if unavailable"
          },
          "banner": {
            "type": "string",
            "nullable": true,
            "description": "From CMS (e.g. image URL path); null if unavailable"
          },
          "main_media": {
            "type": "string",
            "nullable": true,
            "description": "From CMS; only on `GET /api/bet/games/{game_id}`"
          },
          "start_at": {
            "type": "integer",
            "nullable": true,
            "description": "Unix epoch milliseconds from CMS `starts_at`; only on `GET /api/bet/games/{game_id}`"
          },
          "groups": {
            "type": "array",
            "description": "Linked `biz_game_group` rows ordered by id; only on `GET /api/bet/games/{game_id}`",
            "items": {
              "$ref": "#/components/schemas/GameGroup"
            }
          }
        }
      },
      "Market": {
        "type": "object",
        "description": "Public `biz_market` row with nested local game summary. GET /api/bet/markets/{market_id} always embeds `selections`. GET /api/bet/markets list includes `selections` when `include_selections` is true (default); when false the key is omitted.",
        "properties": {
          "id": {
            "type": "integer"
          },
          "game_id": {
            "type": "integer",
            "description": "Local `biz_game.id`"
          },
          "name": {
            "type": "string",
            "description": "Local display label on `biz_market`"
          },
          "status": {
            "type": "integer"
          },
          "ut": {
            "type": "integer",
            "description": "Last update time (milliseconds)"
          },
          "selections": {
            "type": "array",
            "description": "Options under this market (`biz_selection` rows), ordered by id. Omitted on list when `include_selections=0`.",
            "items": {
              "$ref": "#/components/schemas/Selection"
            }
          },
          "game": {
            "type": "object",
            "nullable": true,
            "description": "Nested game summary: same CMS overlay as list games (`title`, `description`, `banner`), excluding `main_media` / `start_at`.",
            "properties": {
              "id": {
                "type": "integer",
                "description": "Local `biz_game.id`"
              },
              "cms_id": {
                "type": "integer"
              },
              "status": {
                "type": "integer"
              },
              "ut": {
                "type": "integer"
              },
              "title": {
                "type": "string",
                "nullable": true
              },
              "description": {
                "type": "string",
                "nullable": true
              },
              "banner": {
                "type": "string",
                "nullable": true
              }
            }
          }
        }
      },
      "Selection": {
        "type": "object",
        "description": "Selection row as embedded in a market payload (`GET /api/bet/markets`, `GET /api/bet/markets/{id}`). No nested market/game objects — parent market carries `game`.",
        "properties": {
          "id": {
            "type": "integer"
          },
          "market_id": {
            "type": "integer",
            "description": "Local `biz_market.id`"
          },
          "label": {
            "type": "string"
          },
          "current_odds_millis": {
            "type": "integer",
            "description": "Decimal odds × 1000 (e.g. 2000 = 2.00)"
          },
          "status": {
            "type": "integer"
          },
          "ut": {
            "type": "integer",
            "description": "Last update time (milliseconds)"
          }
        }
      },
      "PointsAccountRow": {
        "type": "object",
        "description": "`points_balance` row (developer/admin listings).",
        "properties": {
          "id": {
            "type": "integer"
          },
          "uid": {
            "type": "integer"
          },
          "balance": {
            "type": "integer"
          },
          "ct": {
            "type": "string"
          },
          "ut": {
            "type": "string"
          }
        }
      },
      "PointsFlow": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "uid": {
            "type": "integer"
          },
          "oid": {
            "type": "integer"
          },
          "amount": {
            "type": "integer"
          },
          "state": {
            "type": "string"
          },
          "ct": {
            "type": "string"
          },
          "ut": {
            "type": "string"
          }
        }
      }
    },
    "examples": {
      "BetPlaceBody": {
        "summary": "Atomic bet placement (one line)",
        "description": "Retry with the same `X-Request-Id` returns the prior order (`is_replay=true`).",
        "value": {
          "lines": [
            {
              "kid": 1,
              "stake_points": 100,
              "expected_odds_millis": 2000
            }
          ]
        }
      },
      "ApiEnvelopeSuccess": {
        "summary": "Typical API envelope success",
        "value": {
          "data": {},
          "errorCode": 0,
          "message": "",
          "_req_id": "abc123def0"
        }
      }
    }
  },
  "paths": {
    "/up": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/bet/dict": {
      "get": {
        "tags": [
          "Bet"
        ],
        "summary": "Resolve dictionary entries by codes",
        "parameters": [
          {
            "name": "codes",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated MallDictionaryService codes (unknown codes ignored). Examples: `game_status`, `market_status`.",
            "example": "points_hold_state,game_status"
          },
          {
            "name": "X-Request-Id",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Dictionary payload or validation error in envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/bet/games": {
      "get": {
        "tags": [
          "Bet"
        ],
        "summary": "Paginated games (local betting state)",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 15
            }
          },
          {
            "name": "group_code",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 192
            },
            "description": "When set, returns only games linked to `biz_game_group` with this `code` (exact match)."
          }
        ],
        "responses": {
          "200": {
            "description": "Items and pagination",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "items": {
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/Game"
                              }
                            },
                            "pagination": {
                              "$ref": "#/components/schemas/ListPagination"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/bet/games/{game_id}": {
      "get": {
        "tags": [
          "Bet"
        ],
        "summary": "Single game (local betting state)",
        "parameters": [
          {
            "name": "game_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Game",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Game"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/bet/markets": {
      "get": {
        "tags": [
          "Bet"
        ],
        "summary": "Paginated open markets (biz_market); optional filter by game",
        "parameters": [
          {
            "name": "game_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 15
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Items and pagination",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "items": {
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/Market"
                              }
                            },
                            "pagination": {
                              "$ref": "#/components/schemas/ListPagination"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/bet/markets/{market_id}": {
      "get": {
        "tags": [
          "Bet"
        ],
        "summary": "Single market detail",
        "parameters": [
          {
            "name": "market_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Market",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Market"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/bet/orders": {
      "get": {
        "tags": [
          "Bet"
        ],
        "summary": "List current user's orders",
        "security": [
          {
            "UserAccessToken": []
          }
        ],
        "parameters": [
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 15
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paged summaries",
