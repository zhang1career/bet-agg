{
    "openapi": "3.0.3",
    "info": {
        "title": "bet-agg HTTP API",
        "description": "Prediction service; public JSON under `/api/bet/*` plus `/api/openapi.json` and `/up`. Auth to **bet-agg** is **`X-User-Access-Token` only** (raw JWT, no Bearer prefix): copy the user token into this header upstream; **`Authorization` is not validated** for foundation user login on these routes (Bearer is reserved for other gateways). `POST /api/bet/snowflake` mints `data.id` for `X-Request-Id` on `POST /api/bet/place` (idempotency). Responses use ApiResponse envelope: `data`, `errorCode`, `message`, `_req_id`.",
        "version": "2.0.0"
    },
    "servers": [
        {
            "url": "/",
            "description": "Same-origin base path"
        }
    ],
    "tags": [
        {
            "name": "Prediction",
            "description": "Catalog, place, orders, points, leaderboard"
        },
        {
            "name": "Meta",
            "description": "OpenAPI, dictionaries"
        },
        {
            "name": "Health",
            "description": "Liveness"
        }
    ],
    "components": {
        "securitySchemes": {
            "UserAccessToken": {
                "type": "apiKey",
                "in": "header",
                "name": "X-User-Access-Token",
                "description": "Foundation user JWT (raw). Required for authenticated bet routes."
            }
        },
        "schemas": {
            "ApiEnvelope": {
                "type": "object",
                "required": [
                    "data",
                    "errorCode",
                    "message",
                    "_req_id"
                ],
                "properties": {
                    "data": [],
                    "errorCode": {
                        "type": "integer"
                    },
                    "message": {
                        "type": "string"
                    },
                    "_req_id": {
                        "type": "string"
                    }
                }
            },
            "SnowflakeMintData": {
                "type": "object",
                "required": [
                    "id"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^[0-9]+$",
                        "description": "Decimal snowflake; send as X-Request-Id on place."
                    }
                }
            },
            "PointsBalanceData": {
                "type": "object",
                "required": [
                    "balance"
                ],
                "properties": {
                    "balance": {
                        "type": "integer",
                        "description": "User points score (non-redeemable in current flows)."
                    }
                }
            },
            "OrderItemInput": {
                "type": "object",
                "required": [
                    "market_id",
                    "outcome_code"
                ],
                "properties": {
                    "market_id": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "outcome_code": {
                        "type": "string",
                        "maxLength": 32,
                        "description": "Synthetic 1X2: home_win, draw, away_win"
                    }
                }
            },
            "BetPlaceBody": {
                "type": "object",
                "required": [
                    "lines"
                ],
                "properties": {
                    "lines": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 1,
                        "items": {
                            "$ref": "#/components/schemas/OrderItemInput"
                        }
                    }
                }
            },
            "BetOrderLineItem": {
                "type": "object",
                "required": [
                    "market_id",
                    "selection",
                    "pick_label",
                    "result"
                ],
                "properties": {
                    "market_id": {
                        "type": "integer"
                    },
                    "selection": {
                        "type": "object",
                        "additionalProperties": true
                    },
                    "pick_label": {
                        "type": "string"
                    },
                    "result": {
                        "type": "integer",
                        "description": "0 pending, 1 win, 2 lose, 3 void"
                    }
                }
            },
            "BetOrderDetail": {
                "type": "object",
                "required": [
                    "id",
                    "uid",
                    "status",
                    "ct",
                    "ut",
                    "lines"
                ],
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "uid": {
                        "type": "integer"
                    },
                    "status": {
                        "type": "integer"
                    },
                    "ct": {
                        "type": "integer"
                    },
                    "ut": {
                        "type": "integer"
                    },
                    "lines": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/BetOrderLineItem"
                        }
                    }
                }
            },
            "BetOrderSummary": {
                "type": "object",
                "required": [
                    "id",
                    "uid",
                    "status",
                    "ct",
                    "ut"
                ],
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "uid": {
                        "type": "integer"
                    },
                    "status": {
                        "type": "integer"
                    },
                    "ct": {
                        "type": "integer"
                    },
                    "ut": {
                        "type": "integer"
                    }
                }
            },
            "ListPagination": {
                "type": "object",
                "required": [
                    "total",
                    "per_page",
                    "current_page",
                    "last_page"
                ],
                "properties": {
                    "total": {
                        "type": "integer"
                    },
                    "per_page": {
                        "type": "integer"
                    },
                    "current_page": {
                        "type": "integer"
                    },
                    "last_page": {
                        "type": "integer"
                    }
                }
            },
            "LeaderboardEntry": {
                "type": "object",
                "required": [
                    "rank",
                    "uid",
                    "score"
                ],
                "properties": {
                    "rank": {
                        "type": "integer"
                    },
                    "uid": {
                        "type": "integer"
                    },
                    "score": {
                        "type": "integer"
                    }
                }
            },
            "BetSettleOutcomes": {
                "type": "object",
                "required": [
                    "winners",
                    "voids"
                ],
                "properties": {
                    "winners": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "voids": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            },
            "BetGameGroupRef": {
                "type": "object",
                "required": [
                    "id",
                    "code"
                ],
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "code": {
                        "type": "string"
                    }
                }
            },
            "BetGameListItem": {
                "type": "object",
                "required": [
                    "id",
                    "cms_id",
                    "status",
                    "side_a_subject_id",
                    "side_b_subject_id",
                    "side_a_name",
                    "side_b_name",
                    "settle_outcomes",
                    "ut",
                    "title",
                    "description",
                    "banner"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "description": "Local biz_game id."
                    },
                    "cms_id": {
                        "type": "integer",
                        "description": "CMS game raw id."
                    },
                    "status": {
                        "type": "integer"
                    },
                    "side_a_subject_id": {
                        "type": "integer",
                        "nullable": true
                    },
                    "side_b_subject_id": {
                        "type": "integer",
                        "nullable": true
                    },
                    "side_a_name": {
                        "type": "string",
                        "nullable": true
                    },
                    "side_b_name": {
                        "type": "string",
                        "nullable": true
                    },
                    "settle_outcomes": {
                        "$ref": "#/components/schemas/BetSettleOutcomes"
                    },
                    "ut": {
                        "type": "integer",
                        "description": "Updated-at millis."
                    },
                    "title": {
                        "type": "string",
                        "nullable": true
                    },
                    "description": {
                        "type": "string",
                        "nullable": true
                    },
                    "banner": {
                        "type": "string",
                        "nullable": true
                    }
                }
            },
            "BetGameDetail": {
                "allOf": [
                    {
                        "$ref": "#/components/schemas/BetGameListItem"
                    },
                    {
                        "type": "object",
                        "required": [
                            "main_media",
                            "starts_at",
                            "groups"
                        ],
                        "properties": {
                            "main_media": {
                                "type": "string",
                                "nullable": true
                            },
                            "starts_at": {
                                "type": "integer",
                                "nullable": true,
                                "description": "Scheduled start time (epoch millis) from CMS."
                            },
                            "groups": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/components/schemas/BetGameGroupRef"
                                }
                            }
                        }
                    }
                ]
            },
            "BetNestedGame": {
                "type": "object",
                "required": [
                    "id",
                    "cms_id",
                    "status",
                    "side_a_subject_id",
                    "side_b_subject_id",
                    "side_a_name",
                    "side_b_name",
                    "ut",
                    "title",
                    "description",
                    "banner",
                    "starts_at"
                ],
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "cms_id": {
                        "type": "integer"
                    },
                    "status": {
                        "type": "integer"
                    },
                    "side_a_subject_id": {
                        "type": "integer",
                        "nullable": true
                    },
                    "side_b_subject_id": {
                        "type": "integer",
                        "nullable": true
                    },
                    "side_a_name": {
                        "type": "string",
                        "nullable": true
                    },
                    "side_b_name": {
                        "type": "string",
                        "nullable": true
                    },
                    "ut": {
                        "type": "integer"
                    },
                    "title": {
                        "type": "string",
                        "nullable": true
                    },
                    "description": {
                        "type": "string",
                        "nullable": true
                    },
                    "banner": {
                        "type": "string",
                        "nullable": true
                    },
                    "starts_at": {
                        "type": "integer",
                        "nullable": true,
                        "description": "Scheduled start time (epoch millis) from CMS."
                    }
                }
            },
            "BetMarketListItem": {
                "type": "object",
                "required": [
                    "id",
                    "game_id",
                    "type",
                    "name",
                    "status",
                    "ut",
                    "game"
                ],
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "game_id": {
                        "type": "integer"
                    },
                    "type": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "status": {
                        "type": "integer"
                    },
                    "ut": {
                        "type": "integer"
                    },
                    "game": {
                        "oneOf": [
                            {
                                "$ref": "#/components/schemas/BetNestedGame"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    }
                }
            },
            "BetMarketDetail": {
                "allOf": [
                    {
                        "$ref": "#/components/schemas/BetMarketListItem"
                    },
                    {
                        "type": "object",
                        "required": [
                            "selections"
                        ],
                        "properties": {
                            "selections": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "additionalProperties": true
                                }
                            }
                        }
                    }
                ]
            },
            "BetCatalogListData": {
                "type": "object",
                "required": [
                    "items",
                    "pagination",
                    "_dict"
                ],
                "properties": {
                    "items": {
                        "type": "array",
                        "items": {}
                    },
                    "pagination": {
                        "$ref": "#/components/schemas/ListPagination"
                    },
                    "_dict": {
                        "type": "object",
                        "additionalProperties": true
                    }
                }
            }
        },
        "examples": {
            "BetPlaceBody": {
                "summary": "Single-line place request",
                "description": "Retry with same X-Request-Id returns prior order (is_replay=true).",
                "value": {
                    "lines": [
                        {
                            "market_id": 1,
                            "outcome_code": "home_win"
                        }
                    ]
                }
            },
            "ApiEnvelopeSuccess": {
                "summary": "Typical success envelope",
                "value": {
                    "data": [],
                    "errorCode": 0,
                    "message": "",
                    "_req_id": "abc123def0"
                }
            }
        }
    },
    "paths": {
        "/api/bet/games": {
            "get": {
                "tags": [
                    "Prediction"
                ],
                "summary": "List games",
                "parameters": [
                    {
                        "name": "status",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "updated_after",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "id",
                                "-id"
                            ]
                        }
                    },
                    {
                        "name": "group_code",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 15
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/ApiEnvelope"
                                        },
                                        {
                                            "properties": {
                                                "data": {
                                                    "allOf": [
                                                        {
                                                            "$ref": "#/components/schemas/BetCatalogListData"
                                                        },
                                                        {
                                                            "type": "object",
                                                            "properties": {
                                                                "items": {
                                                                    "type": "array",
                                                                    "items": {
                                                                        "$ref": "#/components/schemas/BetGameListItem"
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    ]
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
