                }
              }
            }
          }
        }
      }
    },
    "/api/bet/points": {
      "get": {
        "tags": [
          "Bet"
        ],
        "summary": "Current user's available points balance",
        "description": "`data.balance` is the spendable points integer (same unit as stake and `total_price`).",
        "security": [
          {
            "UserAccessToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Balance",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "object",
                          "required": [
                            "balance"
                          ],
                          "properties": {
                            "balance": {
                              "type": "integer",
                              "description": "Spendable points for the authenticated user"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/bet/place": {
      "post": {
        "tags": [
          "Bet"
        ],
        "summary": "Place a bet atomically (validate odds, debit stake, accept).",
        "description": "Idempotent on `X-Request-Id` (decimal snowflake). Replay → 200 + `is_replay=true`; first accept → 201.",
        "security": [
          {
            "UserAccessToken": []
          }
        ],
        "parameters": [
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Snowflake from POST /api/snowflake/id (digits only)."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "lines"
                ],
                "properties": {
                  "lines": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "kid",
                        "stake_points",
                        "expected_odds_millis"
                      ],
                      "properties": {
                        "kid": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "stake_points": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "expected_odds_millis": {
                          "type": "integer",
                          "minimum": 1000,
                          "description": "Quoted odds × 1000; must match server-side current_odds_millis at place-time."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Bet accepted; stake debited.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope"
                }
              }
            }
          },
          "200": {
            "description": "Idempotent replay; previous order returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "X-Request-Id missing or malformed.",
