{
  "openapi": "3.0.3",
  "info": {
    "title": "bet-agg HTTP API",
    "description": "Laravel bet aggregation service: public `/api/*` JSON APIs and health check. User profile is **not** served here—call the Foundation (or API gateway) user API; bet-agg only **outbounds** to that service to resolve `X-User-Access-Token`. Most JSON responses use the `ApiResponse` envelope (`data`, `errorCode`, `message`, `_req_id`). XXL-Job executor endpoints use a different envelope (`code`, `msg`, `data`). Local catalog state is in `biz_game` (betting status only; titles/images from CMS `/api/cms/game/`), `biz_market`, and `biz_selection`; order lines reference a selection via `kid`.\n\n**Examples:** Reusable request/response samples are under `components.examples` and referenced from operations. **Contract tests:** `Tests\\Feature\\OpenApiRoutesContractTest` asserts every path/method in this file is registered in the app.",
    "version": "1.2.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Same-origin base path (set your deployment host in the client)"
    }
  ],
  "tags": [
    {
      "name": "Bet",
      "description": "Betting catalog, orders, points, checkout"
    },
    {
      "name": "Payment",
      "description": "Payment gateway callbacks"
    },
    {
      "name": "Jobs",
      "description": "XXL-Job executor HTTP surface"
    },
    {
      "name": "Health",
      "description": "Liveness"
    }
  ],
  "components": {
    "securitySchemes": {
      "UserAccessToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-User-Access-Token",
        "description": "Raw JWT from the Foundation (or BFF) auth service; not issued by bet-agg. Send on bet APIs that require a logged-in user."
      },
      "XxlJobAccessToken": {
        "type": "apiKey",
        "in": "header",
        "name": "XXL-JOB-ACCESS-TOKEN",
        "description": "Must match `xxl.token` configuration."
      },
      "PaymentCallbackToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Payment-Callback-Token",
        "description": "Required when `bet_agg.payment.callback_token` is non-empty; must match that secret."
      }
    },
    "schemas": {
      "ApiEnvelope": {
        "type": "object",
        "required": [
          "data",
          "errorCode",
          "message",
          "_req_id"
        ],
        "properties": {
          "data": {},
          "errorCode": {
            "type": "integer",
            "description": "0 = success"
          },
          "message": {
            "type": "string"
          },
          "_req_id": {
            "type": "string"
          }
        }
      },
      "XxlEnvelope": {
        "type": "object",
        "required": [
          "data",
          "code",
          "msg"
        ],
        "properties": {
          "data": {
            "nullable": true
          },
          "code": {
            "type": "integer",
            "description": "200 = success for XXL-Job"
          },
          "msg": {
            "type": "string"
          }
        }
      },
      "BetOrderLine": {
        "type": "object",
        "properties": {
          "kid": {
            "type": "integer",
            "description": "biz_selection.id"
          },
          "stake_points": {
            "type": "integer"
          },
          "decimal_odds_millis": {
            "type": "integer"
          },
          "potential_return_points": {
            "type": "integer"
          },
          "odds_snapshot": {},
          "result": {
            "type": "integer",
            "description": "BetLineResult: 0 pending, 1 win, 2 lose, 3 void"
          }
        }
      },
      "BetOrderFull": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "uid": {
            "type": "integer"
          },
          "status": {
            "type": "integer",
            "description": "BetOrderStatus enum int"
          },
          "total_price": {
            "type": "integer"
          },
          "points_deduct_minor": {
            "type": "integer"
          },
          "cash_payable_minor": {
            "type": "integer"
          },
          "ct": {
            "type": "integer"
          },
          "ut": {
            "type": "integer"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BetOrderLine"
            }
          },
          "ext_inventory": {},
          "ext_id": {},
          "checkout_phase": {
            "type": "string"
          }
        }
      },
      "BetOrderSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "uid": {
            "type": "integer"
          },
          "status": {
            "type": "integer"
          },
          "total_price": {
            "type": "integer"
          },
          "ct": {
            "type": "integer"
          },
          "ut": {
            "type": "integer"
          }
        }
      },
      "ListPagination": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer"
          },
          "per_page": {
            "type": "integer"
          },
          "current_page": {
            "type": "integer"
          },
          "last_page": {
            "type": "integer"
          }
        }
      },
      "SportGame": {
        "type": "object",
        "description": "CMS game fields merged with local `biz_game` betting state. `id` in responses is the external/CMS game id; persistence uses local `biz_game.id` + unique `raw_id`.",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "main_media": {
            "type": "string",
            "nullable": true,
            "description": "CMS `main_media` OSS key"
          },
          "banner": {
            "type": "string",
            "nullable": true,
            "description": "CMS `banner` OSS key"
          },
          "starts_at": {
            "type": "integer",
            "description": "Unix time in milliseconds"
          },
          "status": {
            "type": "integer",
            "description": "1 = open, 2 = closed, 3 = settled"
          },
          "winning_selection_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Set when status is settled; empty array otherwise"
          }
        }
      },
      "SportMarket": {
        "type": "object",
        "description": "Public `biz_market` row with nested game summary (CMS + local state). List endpoint returns open markets on open games only.",
        "properties": {
          "id": {
            "type": "integer"
          },
          "game_id": {
            "type": "integer",
            "description": "CMS game id (same as catalog game `id`), not local `biz_game.id`"
          },
          "name": {
            "type": "string",
            "description": "Local display label on `biz_market`"
          },
          "status": {
            "type": "integer"
          },
          "game": {
            "type": "object",
            "nullable": true,
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "main_media": {
                "type": "string",
                "nullable": true,
                "description": "CMS `main_media` OSS key"
              },
              "banner": {
                "type": "string",
                "nullable": true,
                "description": "CMS `banner` OSS key"
              },
              "starts_at": {
                "type": "integer"
              },
              "status": {
                "type": "integer"
              }
            }
          }
        }
      },
      "SportSelection": {
        "type": "object",
        "description": "Public catalog row; persisted in `biz_selection` with market/game from `biz_market` / `biz_game`.",
        "properties": {
          "id": {
            "type": "integer"
          },
          "label": {
            "type": "string"
          },
          "current_odds_millis": {
            "type": "integer"
          },
          "status": {
            "type": "integer"
          },
          "market": {
            "type": "object",
            "nullable": true,
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "status": {
                "type": "integer"
              }
            }
          },
          "game": {
            "type": "object",
            "nullable": true,
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "main_media": {
                "type": "string",
                "nullable": true,
                "description": "CMS `main_media` OSS key"
              },
              "banner": {
                "type": "string",
                "nullable": true,
                "description": "CMS `banner` OSS key"
              },
              "starts_at": {
                "type": "integer"
              },
              "status": {
                "type": "integer"
              }
            }
          }
        }
      },
      "MallPointsAccount": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "uid": {
            "type": "integer"
          },
          "balance_minor": {
            "type": "integer"
          },
          "ct": {
            "type": "string"
          },
          "ut": {
            "type": "string"
          }
        }
      },
      "PointsFlow": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "uid": {
            "type": "integer"
          },
          "oid": {
            "type": "integer"
          },
          "amount_minor": {
            "type": "integer"
          },
          "state": {
            "type": "string"
          },
          "ct": {
            "type": "string"
          },
          "ut": {
            "type": "string"
          }
        }
      }
    },
    "examples": {
      "BetOrderCreateBody": {
        "summary": "Draft order with one line",
        "description": "See `Tests\\Feature\\BetOrderControllerTest::test_create_order_persists_draft_bet_line`. Replace `kid` with an open `biz_selection.id` from GET `/api/bet/selections`.",
        "value": {
          "lines": [
            {
              "kid": 1,
              "stake_points": 100
            }
          ]
        }
      },
      "BetCheckoutBody": {
        "summary": "Checkout: pay with points",
        "description": "See `Tests\\Feature\\MallCheckoutControllerTest`.",
        "value": {
          "order_id": 1,
          "points_minor": 100
        }
      },
      "BetOrderPatchBody": {
        "summary": "Transition order status",
        "value": {
          "status": "cancelled"
        }
      },
      "PaymentCallbackBody": {
        "summary": "Payment gateway acknowledges paid",
        "description": "See `Tests\\Feature\\PaymentCallbackControllerTest`.",
        "value": {
          "order_id": 1,
          "status": "paid"
        }
      },
      "XxlJobRunBody": {
        "summary": "Executor run payload (flat JSON)",
        "description": "See `Tests\\Feature\\XxlJobControllerTest::test_run_dispatches_close_expired_orders_and_cancels_pending`.",
        "value": {
          "jobId": 9001,
          "executorHandler": "closeExpiredOrders",
          "executorParams": "",
          "logId": 55001,
          "logDateTime": 1700000000000
        }
      },
      "XxlJobKillBody": {
        "summary": "Kill job lock by id",
        "value": {
          "jobId": "777"
        }
      },
      "ApiEnvelopeSuccess": {
        "summary": "Typical API envelope success",
        "value": {
          "data": {},
          "errorCode": 0,
          "message": "",
          "_req_id": "abc123def0"
        }
      }
    }
  },
  "paths": {
    "/up": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/bet/dict": {
      "get": {
        "tags": [
          "Bet"
        ],
        "summary": "Resolve dictionary entries by codes",
        "parameters": [
          {
            "name": "codes",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated MallDictionaryService codes (unknown codes ignored).",
            "example": "points_hold_state"
          },
          {
            "name": "X-Request-Id",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Dictionary payload or validation error in envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/bet/games": {
      "get": {
        "tags": [
          "Bet"
        ],
        "summary": "Paginated open games (local biz_game + CMS)",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 15
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Items and pagination",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "items": {
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/SportGame"
                              }
                            },
                            "pagination": {
                              "$ref": "#/components/schemas/ListPagination"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/bet/games/{game_id}": {
      "get": {
        "tags": [
          "Bet"
        ],
        "summary": "Single game detail (CMS + local state)",
        "parameters": [
          {
            "name": "game_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Game",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/SportGame"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/bet/markets": {
      "get": {
        "tags": [
          "Bet"
        ],
        "summary": "Paginated open markets (biz_market); optional filter by game",
        "parameters": [
          {
            "name": "game_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 15
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Items and pagination",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "items": {
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/SportMarket"
                              }
                            },
                            "pagination": {
                              "$ref": "#/components/schemas/ListPagination"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/bet/markets/{market_id}": {
      "get": {
        "tags": [
          "Bet"
        ],
        "summary": "Single market detail",
        "parameters": [
          {
            "name": "market_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Market",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/SportMarket"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/bet/selections": {
      "get": {
        "tags": [
          "Bet"
        ],
        "summary": "Paginated open selections (biz_selection)",
        "parameters": [
          {
            "name": "market_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "When set, only selections for this market"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 15
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Items and pagination",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "items": {
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/SportSelection"
                              }
                            },
                            "pagination": {
                              "$ref": "#/components/schemas/ListPagination"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/bet/selections/{id}": {
      "get": {
        "tags": [
          "Bet"
        ],
        "summary": "Single selection detail",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Selection",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/SportSelection"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/bet/orders": {
      "get": {
        "tags": [
          "Bet"
        ],
        "summary": "List current user's orders",
        "security": [
          {
            "UserAccessToken": []
          }
        ],
        "parameters": [
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 15
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paged summaries",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "object",
                          "properties": {
                            "items": {
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/BetOrderSummary"
                              }
                            },
                            "pagination": {
                              "$ref": "#/components/schemas/ListPagination"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Bet"
        ],
        "summary": "Create draft pending order (exactly one line)",
        "security": [
          {
            "UserAccessToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "lines"
                ],
                "properties": {
                  "lines": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "kid",
                        "stake_points"
                      ],
                      "properties": {
                        "kid": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "stake_points": {
                          "type": "integer",
                          "minimum": 1
                        }
                      }
                    }
                  }
                }
              },
              "examples": {
                "oneLineDraft": {
                  "$ref": "#/components/examples/BetOrderCreateBody"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/BetOrderFull"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiEnvelope"
                }
              }
            }
          },
