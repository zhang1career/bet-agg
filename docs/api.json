{
    "openapi": "3.0.3",
    "info": {
        "title": "bet-agg HTTP API",
        "description": "Prediction + reputation service (no stakes, no odds, no redeemable balance). Public JSON under `/api/bet/*` plus `/api/openapi.json` and `/up`. Auth: gateway forwards `Authorization: Bearer` as `X-User-Access-Token` (raw JWT); bet-agg validates `X-User-Access-Token` only. `POST /api/bet/snowflake` mints `data.id` for `X-Request-Id` on `POST /api/bet/submit` (idempotency). Responses use ApiResponse envelope: `data`, `errorCode`, `message`, `_req_id`.",
        "version": "2.0.0"
    },
    "servers": [
        {
            "url": "/",
            "description": "Same-origin base path"
        }
    ],
    "tags": [
        {
            "name": "Prediction",
            "description": "Catalog, submit, orders, reputation, leaderboard"
        },
        {
            "name": "Meta",
            "description": "OpenAPI, dictionaries"
        },
        {
            "name": "Health",
            "description": "Liveness"
        }
    ],
    "components": {
        "securitySchemes": {
            "BearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT",
                "description": "User access token at gateway edge."
            },
            "UserAccessToken": {
                "type": "apiKey",
                "in": "header",
                "name": "X-User-Access-Token",
                "description": "Raw JWT reaching bet-agg."
            }
        },
        "schemas": {
            "ApiEnvelope": {
                "type": "object",
                "required": [
                    "data",
                    "errorCode",
                    "message",
                    "_req_id"
                ],
                "properties": {
                    "data": [],
                    "errorCode": {
                        "type": "integer"
                    },
                    "message": {
                        "type": "string"
                    },
                    "_req_id": {
                        "type": "string"
                    }
                }
            },
            "SnowflakeMintData": {
                "type": "object",
                "required": [
                    "id"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^[0-9]+$",
                        "description": "Decimal snowflake; send as X-Request-Id on submit."
                    }
                }
            },
            "ReputationData": {
                "type": "object",
                "required": [
                    "score"
                ],
                "properties": {
                    "score": {
                        "type": "integer",
                        "description": "Non-redeemable reputation score."
                    }
                }
            },
            "OrderItemInput": {
                "type": "object",
                "required": [
                    "market_id",
                    "outcome_code"
                ],
                "properties": {
                    "market_id": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "outcome_code": {
                        "type": "string",
                        "maxLength": 32,
                        "description": "Synthetic 1X2: home_win, draw, away_win"
                    }
                }
            },
            "BetSubmitBody": {
                "type": "object",
                "required": [
                    "lines"
                ],
                "properties": {
                    "lines": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 1,
                        "items": {
                            "$ref": "#/components/schemas/OrderItemInput"
                        }
                    }
                }
            },
            "BetOrderLineItem": {
                "type": "object",
                "required": [
                    "market_id",
                    "selection",
                    "pick_label",
                    "result"
                ],
                "properties": {
                    "market_id": {
                        "type": "integer"
                    },
                    "selection": {
                        "type": "object",
                        "additionalProperties": true
                    },
                    "pick_label": {
                        "type": "string"
                    },
                    "result": {
                        "type": "integer",
                        "description": "0 pending, 1 win, 2 lose, 3 void"
                    }
                }
            },
            "BetOrderDetail": {
                "type": "object",
                "required": [
                    "id",
                    "uid",
                    "status",
                    "ct",
                    "ut",
                    "lines"
                ],
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "uid": {
                        "type": "integer"
                    },
                    "status": {
                        "type": "integer"
                    },
                    "ct": {
                        "type": "integer"
                    },
                    "ut": {
                        "type": "integer"
                    },
                    "lines": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/BetOrderLineItem"
                        }
                    }
                }
            },
            "BetOrderSummary": {
                "type": "object",
                "required": [
                    "id",
                    "uid",
                    "status",
                    "ct",
                    "ut"
                ],
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "uid": {
                        "type": "integer"
                    },
                    "status": {
                        "type": "integer"
                    },
                    "ct": {
                        "type": "integer"
                    },
                    "ut": {
                        "type": "integer"
                    }
                }
            },
            "ListPagination": {
                "type": "object",
                "required": [
                    "total",
                    "per_page",
                    "current_page",
                    "last_page"
                ],
                "properties": {
                    "total": {
                        "type": "integer"
                    },
                    "per_page": {
                        "type": "integer"
                    },
                    "current_page": {
                        "type": "integer"
                    },
                    "last_page": {
                        "type": "integer"
                    }
                }
            },
            "LeaderboardEntry": {
                "type": "object",
                "required": [
                    "rank",
                    "uid",
                    "score"
                ],
                "properties": {
                    "rank": {
                        "type": "integer"
                    },
                    "uid": {
                        "type": "integer"
                    },
                    "score": {
                        "type": "integer"
                    }
                }
            }
        },
        "examples": {
            "BetSubmitBody": {
                "summary": "Single-line prediction submit",
                "description": "Retry with same X-Request-Id returns prior order (is_replay=true).",
                "value": {
                    "lines": [
                        {
                            "market_id": 1,
                            "outcome_code": "home_win"
                        }
                    ]
                }
            },
            "ApiEnvelopeSuccess": {
                "summary": "Typical success envelope",
                "value": {
                    "data": [],
                    "errorCode": 0,
                    "message": "",
                    "_req_id": "abc123def0"
                }
            }
        }
    },
    "paths": {
        "/up": {
            "get": {
                "tags": [
                    "Health"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/api/openapi.json": {
            "get": {
                "tags": [
                    "Meta"
                ],
                "summary": "OpenAPI 3 document",
                "responses": {
                    "200": {
                        "description": "Spec",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/bet/dict": {
            "get": {
                "tags": [
                    "Meta"
                ],
                "summary": "Dictionary lookup",
                "parameters": [
                    {
                        "name": "codes",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/ApiEnvelope"
                                        },
                                        {
                                            "properties": {
                                                "data": {
                                                    "type": "object",
                                                    "additionalProperties": true
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/bet/games": {
            "get": {
                "tags": [
                    "Prediction"
                ],
                "summary": "List games",
                "parameters": [
                    {
                        "name": "status",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "updated_after",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "id",
                                "-id"
                            ]
                        }
                    },
                    {
                        "name": "group_code",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 15
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/ApiEnvelope"
                                        },
                                        {
                                            "properties": {
                                                "data": {
                                                    "type": "object"
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/bet/games/{game_id}": {
            "get": {
                "tags": [
                    "Prediction"
                ],
                "summary": "Game detail",
                "parameters": [
                    {
                        "name": "game_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/ApiEnvelope"
                                        },
                                        {
                                            "properties": {
                                                "data": {
                                                    "type": "object"
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/bet/markets": {
            "get": {
                "tags": [
                    "Prediction"
                ],
                "summary": "List markets",
                "parameters": [
                    {
                        "name": "game_id",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "status",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "updated_after",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/ApiEnvelope"
                                        },
                                        {
                                            "properties": {
                                                "data": {
                                                    "type": "object"
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/bet/markets/{market_id}": {
            "get": {
                "tags": [
                    "Prediction"
                ],
                "summary": "Market detail",
                "parameters": [
                    {
                        "name": "market_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/ApiEnvelope"
                                        },
                                        {
                                            "properties": {
                                                "data": {
                                                    "type": "object"
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/bet/leaderboard": {
            "get": {
                "tags": [
                    "Prediction"
                ],
                "summary": "Reputation leaderboard",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/ApiEnvelope"
                                        },
                                        {
                                            "properties": {
                                                "data": {
                                                    "type": "object",
                                                    "required": [
                                                        "items",
                                                        "pagination"
                                                    ],
                                                    "properties": {
                                                        "items": {
                                                            "type": "array",
                                                            "items": {
                                                                "$ref": "#/components/schemas/LeaderboardEntry"
                                                            }
                                                        },
                                                        "pagination": {
                                                            "$ref": "#/components/schemas/ListPagination"
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/bet/orders": {
            "get": {
                "tags": [
                    "Prediction"
                ],
                "summary": "My prediction orders",
                "security": [
                    {
                        "BearerAuth": []
                    },
                    {
                        "UserAccessToken": []
                    }
                ],
                "parameters": [
                    {
                        "name": "per_page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 15
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/ApiEnvelope"
                                        },
                                        {
                                            "properties": {
                                                "data": {
                                                    "type": "object"
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/bet/orders/{id}": {
            "get": {
                "tags": [
                    "Prediction"
                ],
                "summary": "Order detail",
                "security": [
                    {
                        "BearerAuth": []
                    },
                    {
                        "UserAccessToken": []
                    }
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/ApiEnvelope"
                                        },
                                        {
                                            "properties": {
                                                "data": {
                                                    "type": "object"
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/bet/reputation": {
            "get": {
                "tags": [
                    "Prediction"
                ],
                "summary": "My reputation score",
                "security": [
                    {
                        "BearerAuth": []
                    },
                    {
                        "UserAccessToken": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/ApiEnvelope"
                                        },
                                        {
                                            "properties": {
                                                "data": {
                                                    "$ref": "#/components/schemas/ReputationData"
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/bet/snowflake": {
            "post": {
                "tags": [
                    "Prediction"
                ],
                "summary": "Mint snowflake id",
                "security": [
                    {
                        "BearerAuth": []
                    },
                    {
                        "UserAccessToken": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/ApiEnvelope"
                                        },
                                        {
                                            "properties": {
                                                "data": {
                                                    "$ref": "#/components/schemas/SnowflakeMintData"
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/bet/submit": {
            "post": {
                "tags": [
                    "Prediction"
                ],
                "summary": "Submit prediction",
                "security": [
                    {
                        "BearerAuth": []
                    },
                    {
                        "UserAccessToken": []
                    }
                ],
                "parameters": [
                    {
                        "name": "X-Request-Id",
                        "in": "header",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/BetSubmitBody"
                            },
                            "examples": {
                                "sample": {
                                    "$ref": "#/components/examples/BetSubmitBody"
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Idempotent replay",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/ApiEnvelope"
                                        },
                                        {
                                            "properties": {
                                                "data": {
                                                    "type": "object",
                                                    "required": [
                                                        "order",
                                                        "is_replay",
                                                        "_dict"
                                                    ]
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "201": {
                        "description": "Created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/ApiEnvelope"
                                        },
                                        {
                                            "properties": {
                                                "data": {
                                                    "type": "object"
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}