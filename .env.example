# 分层环境（与 user-agg 一致，见 bootstrap/app.php + paganini LayeredEnvLoader）：
# 1) 先加载项目根目录的 `.env`；
# 2) 仅当 `APP_ENV` 为 dev / test / prod 时，再加载同目录下的 `.env.{APP_ENV}`（如 `APP_ENV=prod` → `.env.prod`），
#    后者覆盖前者中的同名变量。
# 本地开发可保持 `APP_ENV=local`；PHPUnit 使用 `APP_ENV=testing`，均不会加载叠加文件。
APP_NAME=bet-agg
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# 应用时区（Monolog 行时间、Carbon 等；东八区请用 Asia/Shanghai）
APP_TIMEZONE=Asia/Shanghai
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Service Management
SM_EXECUTION_MODE=serial
SM_DEGRADE_STRATEGY=mask_null
SM_PARTIAL_FAILURE_CODE=20601
SM_PARTIAL_FAILURE_MESSAGE="Partially failed, degraded by aggregator."
# Service Discovery
SD_CACHE_CONN=default
SD_CACHE_KEY_PREFIX=reg:serv:

# log (outbound Http client request/response logs: App\Http\Client\OutboundHttpDebugMiddleware when APP_DEBUG=true)
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bet_agg
DB_USERNAME=zhang
DB_PASSWORD=123456

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=array

# API gateway (user center, OSS, etc.; paths per service-foundation).
# When the URL contains `://{{service_key}}`, resolve from Redis (paganini); see API_GATEWAY_SD_* below.
API_GATEWAY_BASE_URL=http://nginx:8010
API_GATEWAY_TIMEOUT_SECONDS=3

# Service Foundation (optional CMS route name, if used elsewhere)
SF_CMS_CONTENT_ROUTE=bet
# Optional: require X-Payment-Callback-Token on POST /api/bet/payment/callback
BET_PAYMENT_CALLBACK_TOKEN=

# OSS uploads (admin media; foundation PUT /api/oss/{bucket}/{key}); game assets use keys banner/* and main_media/*
BET_OSS_BUCKET=bet

# Pending checkout window before XXL-Job `closeExpiredOrders` cancels pending bets (ms).
BET_PENDING_PAYMENT_TIMEOUT_MS=1800000

# Admin JSON API (`Authorization: Bearer <token>`) for POST /api/bet/admin/points/*
BET_ADMIN_API_TOKEN=

# XXL-Job：Admin 调 POST /api/xxl-job/run（同步执行，Header: XXL-JOB-ACCESS-TOKEN）。
# Plain URL or service-discovery template (same as API_GATEWAY_BASE_URL): http://{{service_key}}/xxl-job-admin
XXL_JOB_ADMIN_ADDRESS=http://xxl-job:8080/xxl-job-admin
XXL_JOB_TOKEN=

VITE_APP_NAME="${APP_NAME}"
